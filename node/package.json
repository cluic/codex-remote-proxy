{
  "name": "@cluic/codex-remote-proxy",
  "version": "0.4.21",
  "description": "Local supervisor and Web UI for routing Codex through OpenAI-compatible providers while preserving ChatGPT sign-in",
  "license": "MIT",
  "keywords": [
    "codex",
    "openai",
    "chatgpt",
    "proxy",
    "cli",
    "provider"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cluic/codex-remote-proxy.git"
  },
  "homepage": "https://github.com/cluic/codex-remote-proxy#readme",
  "bugs": {
    "url": "https://github.com/cluic/codex-remote-proxy/issues"
  },
  "files": [
    "bin/",
    "src/",
    "ui/",
    "proxy-config.example.json",
    "README.md"
  ],
  "bin": {
    "crp": "bin/crp.mjs"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "check": "node bin/crp.mjs check",
    "status": "node bin/crp.mjs status",
    "guide": "node bin/crp.mjs guide",
    "dev:cli": "node bin/crp.mjs",
    "lint": "node scripts/check-source.mjs",
    "build:ui": "node scripts/build-next-ui.mjs",
    "verify:ui-assets": "node scripts/verify-ui-assets.mjs",
    "typecheck:ui": "tsc -p tsconfig.ui.json",
    "verify:ui-build": "node scripts/verify-ui-build.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node scripts/run-test-group.mjs unit",
    "test:integration": "node scripts/run-test-group.mjs integration",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run test && npm run test:e2e",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-lockfile-version.mjs",
    "release": "changeset publish"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "@changesets/parse": {
      "js-yaml": "4.3.1"
    },
    "nanoid": "3.3.18",
    "read-yaml-file": {
      "js-yaml": "3.15.2"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "fzstd": "^0.1.1"
  },
  "devDependencies": {
    "@base-ui/react": "1.8.0",
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.5",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
}
